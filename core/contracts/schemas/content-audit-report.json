{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/content-audit-report.json",
  "title": "Content Audit Report",
  "description": "Structured deliverable emitted by Content Manager using audit-content skill. Records portfolio-wide or URL-level content audit results, ROT classifications, AI semantic flaw scores, information gain ratings, 3-tier decay tags, remediation SLAs, slop-risk flags, and refresh actions.",
  "type": "object",
  "required": [
    "contract_type",
    "audit_id",
    "created_at",
    "site",
    "audit_scope",
    "audited_items",
    "portfolio_summary",
    "handoff"
  ],
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "content-audit-report",
      "description": "Machine-readable contract discriminator."
    },
    "audit_id": {
      "type": "string",
      "description": "Unique identifier for this audit. Convention: YYYY-MM-DD-site-scope."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "site": {
      "type": "string",
      "description": "Target site slug (e.g. authority-blog, hugo-twin, real-estate, hvac-portal)."
    },
    "audit_scope": {
      "type": "string",
      "description": "Pillar, cluster, or URL scope audited."
    },
    "audited_items": {
      "type": "array",
      "description": "Audit findings per individual URL.",
      "items": {
        "type": "object",
        "required": [
          "url_or_path",
          "action",
          "ai_semantic_flaw_score",
          "information_gain_rating",
          "rot_classification"
        ],
        "properties": {
          "url_or_path": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "keep_as_is",
              "refresh",
              "expand",
              "consolidate",
              "redirect",
              "retire"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "traffic_trend": {
            "type": "string",
            "enum": [
              "growing",
              "stable",
              "declining",
              "zero_traffic"
            ]
          },
          "staleness_months": {
            "type": "number"
          },
          "decay_tier": {
            "type": "string",
            "enum": [
              "none",
              "tier1_algorithmic_serp",
              "tier2_geo_citation",
              "tier3_factual_temporal"
            ],
            "description": "3-tier decay classification per content-manager-governance-standards.md: Tier 1 (rank drop >3 positions or impressions -25% MoM), Tier 2 (GEO/AI citation drop >=15% over 30 days), Tier 3 (statistics >18 months, deprecated APIs, broken links)."
          },
          "sla_deadline": {
            "type": "string",
            "format": "date",
            "description": "Remediation SLA deadline per the 4-tier triage action plan: Quick Patch <=15d, Structural Rewrite <=30d, Consolidation/301 <=20d, Decommission/410 <=10d."
          },
          "slop_risk_flagged": {
            "type": "boolean",
            "description": "True when the URL is queued in the portfolio slop_risk_inventory for intro formula drift, substance-free sections, or repetitive conclusions."
          },
          "rot_classification": {
            "type": "string",
            "enum": [
              "none",
              "redundant",
              "outdated",
              "trivial"
            ]
          },
          "ai_semantic_flaw_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "cliches_present": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "information_gain_rating": {
            "type": "string",
            "enum": [
              "exceptional",
              "strong",
              "moderate",
              "low",
              "zero"
            ]
          },
          "geo_readiness_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "portfolio_summary": {
      "type": "object",
      "required": [
        "total_urls_audited",
        "action_counts",
        "average_ai_semantic_flaw_score",
        "average_information_gain_rating"
      ],
      "properties": {
        "total_urls_audited": {
          "type": "integer"
        },
        "action_counts": {
          "type": "object",
          "properties": {
            "keep_as_is": {
              "type": "integer"
            },
            "refresh": {
              "type": "integer"
            },
            "expand": {
              "type": "integer"
            },
            "consolidate": {
              "type": "integer"
            },
            "redirect": {
              "type": "integer"
            },
            "retire": {
              "type": "integer"
            }
          }
        },
        "average_ai_semantic_flaw_score": {
          "type": "number"
        },
        "average_information_gain_rating": {
          "type": "string"
        }
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "status",
        "action_required",
        "recommended_next_roles"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "audit_completed",
            "refreshes_delegated",
            "governance_action_needed"
          ]
        },
        "action_required": {
          "type": "string"
        },
        "recommended_next_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "content-writer",
              "seo-analyst",
              "frontend-developer",
              "data-analyst"
            ]
          }
        }
      }
    }
  },
  "examples": [
    {
      "contract_type": "content-audit-report",
      "audit_id": "2026-09-05-authority-blog-architecture-audit",
      "created_at": "2026-09-05T10:00:00+07:00",
      "site": "authority-blog",
      "audit_scope": "Technical Architecture & API Guides",
      "audited_items": [
        {
          "url_or_path": "posts/microservices-event-sourcing-patterns",
          "title": "Event Sourcing Patterns in Production",
          "action": "refresh",
          "rationale": "High traffic but contains robotic cadence and lacks 2026 production telemetry metrics.",
          "traffic_trend": "declining",
          "staleness_months": 14,
          "decay_tier": "tier1_algorithmic_serp",
          "sla_deadline": "2026-10-05",
          "slop_risk_flagged": true,
          "rot_classification": "outdated",
          "ai_semantic_flaw_score": 28,
          "cliches_present": [
            "delve",
            "tapestry",
            "game-changer"
          ],
          "information_gain_rating": "moderate",
          "geo_readiness_score": 62
        }
      ],
      "portfolio_summary": {
        "total_urls_audited": 1,
        "action_counts": {
          "keep_as_is": 0,
          "refresh": 1,
          "expand": 0,
          "consolidate": 0,
          "redirect": 0,
          "retire": 0
        },
        "average_ai_semantic_flaw_score": 28.0,
        "average_information_gain_rating": "moderate"
      },
      "handoff": {
        "status": "refreshes_delegated",
        "action_required": "Delegate refresh to Content Writer with strict anti-cliche directive and firsthand benchmark integration.",
        "recommended_next_roles": [
          "content-writer",
          "seo-analyst"
        ]
      }
    }
  ]
}
