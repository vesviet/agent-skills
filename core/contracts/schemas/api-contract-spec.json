{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api-contract-spec",
  "title": "API Contract Specification",
  "description": "Structured output defining an API endpoint contract. Used for backend-to-frontend handoff and A2A delegation.",
  "type": "object",
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "api-contract-spec",
      "description": "Machine-readable contract discriminator."
    },
    "endpoint": {
      "type": "string",
      "description": "The route path (e.g., /api/v1/orders/{id})."
    },
    "method": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS"
      ]
    },
    "description": {
      "type": "string",
      "description": "What this endpoint does and its business logic."
    },
    "auth_required": {
      "type": "boolean",
      "description": "Whether authentication/authorization is required."
    },
    "request_payload": {
      "type": "object",
      "description": "JSON Schema or definition of the expected request body/query parameters."
    },
    "response_success": {
      "type": "object",
      "description": "Expected successful response shape and status code."
    },
    "response_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status_code": {
            "type": "integer"
          },
          "error_code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "status_code",
          "error_code"
        ]
      },
      "description": "Expected failure responses."
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Events fired, database mutations, or cache invalidations."
    },
    "blast_radius_assessment": {
      "type": "object",
      "description": "Assessment of endpoint blast radius, failure domain, and resiliency policy.",
      "properties": {
        "failure_domain": {
          "type": "string"
        },
        "circuit_breaker_policy": {
          "type": "string"
        },
        "slo_impact": {
          "type": "string"
        }
      },
      "required": [
        "failure_domain"
      ]
    },
    "sandbox_isolation_tier": {
      "type": "string",
      "enum": [
        "tier_0_ephemeral_container",
        "tier_1_isolated_microvm",
        "tier_2_airgapped_sandbox",
        "local_dev_workspace"
      ],
      "description": "Required execution environment isolation tier for testing this endpoint."
    },
    "mutation_score_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Target mutation test kill score percentage (e.g., 75.0) for tests exercising this endpoint."
    },
    "idempotency_guarantee": {
      "type": "string",
      "enum": [
        "idempotent_header_required",
        "naturally_idempotent",
        "non_idempotent_strictly_guarded"
      ],
      "description": "Idempotency behavior and client header guarantee."
    }
  },
  "required": [
    "contract_type",
    "endpoint",
    "method",
    "response_success",
    "response_errors"
  ],
  "examples": [
    {
      "contract_type": "api-contract-spec",
      "endpoint": "/api/v1/orders/{id}/assign-courier",
      "method": "POST",
      "description": "Assign a courier to a COD order. Triggers COD store routing if store_id is set.",
      "auth_required": true,
      "request_payload": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "integer"
          },
          "store_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "payment_method": {
            "type": "string",
            "enum": [
              "cod",
              "bank_transfer",
              "cash"
            ]
          }
        },
        "required": [
          "order_id",
          "payment_method"
        ]
      },
      "response_success": {
        "status_code": 200,
        "body": {
          "assignment_id": "integer",
          "courier_id": "integer",
          "routed_to": "string"
        }
      },
      "response_errors": [
        {
          "status_code": 404,
          "error_code": "ORDER_NOT_FOUND",
          "description": "Order ID does not exist"
        },
        {
          "status_code": 503,
          "error_code": "STORE_SERVICE_UNAVAILABLE",
          "description": "Store courier lookup failed; retry or use fallback"
        }
      ],
      "side_effects": [
        "order.assignment.created event published",
        "warehouse_courier_pool updated if fallback triggered"
      ],
      "blast_radius_assessment": {
        "failure_domain": "order_fulfillment",
        "circuit_breaker_policy": "trip_at_50pct_failures_in_10s_fallback_warehouse",
        "slo_impact": "critical_path_order_processing"
      },
      "sandbox_isolation_tier": "tier_0_ephemeral_container",
      "mutation_score_threshold": 75.0,
      "idempotency_guarantee": "idempotent_header_required"
    }
  ]
}
