{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "documentation-handoff",
  "title": "Documentation Handoff",
  "description": "Structured documentation deliverable from Technical Writer.",
  "type": "object",
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "documentation-handoff"
    },
    "topic": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "doc_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "readme",
        "api_reference",
        "runbook",
        "release_notes",
        "setup_guide",
        "troubleshooting",
        "other"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "adr-spec",
              "implementation-result",
              "api-contract-spec",
              "incident-report",
              "code",
              "other"
            ]
          },
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "ref"
        ]
      }
    },
    "changed_behavior_summary": {
      "type": "string"
    },
    "preserved_behavior_summary": {
      "type": "string"
    },
    "verified_facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stale_docs_removed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review_ready",
        "published"
      ]
    }
  },
  "required": [
    "contract_type",
    "topic",
    "audience",
    "doc_paths",
    "doc_type",
    "status"
  ],
  "examples": [
    {
      "contract_type": "documentation-handoff",
      "handoff_id": "2026-06-12-cod-routing-docs",
      "feature_ticket_ref": "2026-06-12-change-store-order-cod",
      "implementation_result_ref": "slice-01-command-logic",
      "pages_to_update": [
        {
          "path": "docs/order-assignment-runbook.md",
          "change": "Add COD store routing section with fallback behavior description"
        },
        {
          "path": "docs/api/orders.md",
          "change": "Document new store_id field behavior in POST /orders/assign-courier"
        }
      ],
      "new_pages_needed": [],
      "verified_facts": [
        "COD orders with store_id route to store courier; fallback to warehouse with warning log on no active courier"
      ],
      "release_notes_snippet": "COD orders with a store_id are now routed to store-specific couriers for faster delivery. Warehouse fallback applies when no store courier is available."
    }
  ]
}
