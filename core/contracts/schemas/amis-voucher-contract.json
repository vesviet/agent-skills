{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "amis-voucher-contract",
  "title": "AMIS Accounting Voucher Contract",
  "description": "Enterprise financial schema for multi-channel retail vouchers (Sales Invoices, Delivery Notes cum Sales Invoices, Receipt Vouchers, and Platform Fee Allocations) exported to MISA AMIS ERP, enforcing VAS 14 revenue recognition, 3-tier voucher breakdown, pre-tax VAT decomposition, and strict debit-credit balance verification.",
  "type": "object",
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "amis-voucher-contract",
      "description": "Machine-readable contract discriminator."
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,100}$",
      "description": "Unique identifier for the voucher export batch (e.g., AMIS-BATCH-2026-08-SHOPEE-01)."
    },
    "accounting_period": {
      "type": "object",
      "properties": {
        "period": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
          "description": "Accounting period in YYYY-MM format."
        },
        "from_date": {
          "type": "string",
          "format": "date"
        },
        "to_date": {
          "type": "string",
          "format": "date"
        }
      },
      "required": ["period", "from_date", "to_date"]
    },
    "legal_entity": {
      "type": "object",
      "properties": {
        "legal_name": {
          "type": "string"
        },
        "tax_code": {
          "type": "string",
          "pattern": "^[0-9]{10}(-[0-9]{3})?$"
        },
        "currency": {
          "type": "string",
          "enum": ["VND"],
          "default": "VND"
        }
      },
      "required": ["legal_name", "tax_code", "currency"]
    },
    "accounting_regime": {
      "type": "string",
      "enum": ["TT-200-2014", "TT-133-2016"],
      "description": "Statutory Vietnam accounting regime governing account codes and posting rules."
    },
    "channel": {
      "type": "string",
      "enum": ["shopee", "tiktok", "retail_offline", "lazada", "wholesale", "other"],
      "description": "Sales channel originating the voucher batch."
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_vouchers": {
          "type": "integer",
          "minimum": 1
        },
        "total_gross_revenue": {
          "type": "number",
          "minimum": 0
        },
        "total_pretax_amount": {
          "type": "number",
          "minimum": 0
        },
        "total_vat_amount": {
          "type": "number",
          "minimum": 0
        },
        "total_discount_amount": {
          "type": "number",
          "minimum": 0
        },
        "total_platform_fees": {
          "type": "number",
          "minimum": 0
        },
        "total_debit": {
          "type": "number",
          "minimum": 0
        },
        "total_credit": {
          "type": "number",
          "minimum": 0
        },
        "is_balanced": {
          "type": "boolean",
          "const": true,
          "description": "True if total_debit == total_credit."
        }
      },
      "required": [
        "total_vouchers",
        "total_gross_revenue",
        "total_pretax_amount",
        "total_vat_amount",
        "total_debit",
        "total_credit",
        "is_balanced"
      ]
    },
    "vouchers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "voucher_no": {
            "type": "string",
            "description": "Official voucher number (e.g. SHOPEEHNT0826001)."
          },
          "voucher_type": {
            "type": "string",
            "enum": [
              "sales_invoice",
              "delivery_note_cum_sales_invoice",
              "receipt_voucher",
              "platform_fee_allocation",
              "sales_return"
            ],
            "description": "AMIS voucher document type."
          },
          "posting_date": {
            "type": "string",
            "format": "date"
          },
          "voucher_date": {
            "type": "string",
            "format": "date"
          },
          "warehouse_code": {
            "type": "string",
            "description": "AMIS warehouse identifier (e.g. CH009, CH060, CH077, CH112, KHO_TONG)."
          },
          "customer_code": {
            "type": "string",
            "description": "AMIS customer/partner code (e.g. CH009, CH077, KHACHLE)."
          },
          "unit_code": {
            "type": "string",
            "description": "AMIS branch/business unit code (Mã đơn vị)."
          },
          "description": {
            "type": "string"
          },
          "vas14_compliance": {
            "type": "object",
            "properties": {
              "order_status": {
                "type": "string",
                "enum": ["delivered", "completed", "returned", "cancelled", "in_transit"]
              },
              "revenue_recognized": {
                "type": "boolean"
              },
              "vas14_satisfied": {
                "type": "boolean"
              },
              "risk_transfer_verified": {
                "type": "boolean"
              }
            },
            "required": [
              "order_status",
              "revenue_recognized",
              "vas14_satisfied",
              "risk_transfer_verified"
            ]
          },
          "ecommerce_breakdown": {
            "type": "object",
            "properties": {
              "gross_order_value": {
                "type": "number",
                "minimum": 0
              },
              "shop_voucher_amount": {
                "type": "number",
                "minimum": 0,
                "description": "Seller funded discount (TK 5211)."
              },
              "platform_voucher_amount": {
                "type": "number",
                "minimum": 0,
                "description": "Platform funded voucher (TK 1388 receivable, does not reduce shop revenue)."
              },
              "platform_subsidy_amount": {
                "type": "number",
                "minimum": 0,
                "description": "Platform promotional price subsidy."
              },
              "platform_commission_fee": {
                "type": "number",
                "minimum": 0,
                "description": "Platform commission (TK 641)."
              },
              "platform_payment_fee": {
                "type": "number",
                "minimum": 0,
                "description": "Payment gateway processing fee (TK 641)."
              },
              "platform_service_fee": {
                "type": "number",
                "minimum": 0,
                "description": "Campaign / Freeship Xtra service fee (TK 641)."
              },
              "net_payout_amount": {
                "type": "number",
                "minimum": 0,
                "description": "Net cash receivable/received from platform."
              }
            }
          },
          "line_items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "line_no": {
                  "type": "integer",
                  "minimum": 1
                },
                "item_code": {
                  "type": "string",
                  "description": "AMIS SKU / item code."
                },
                "item_name": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "unit_price_pretax": {
                  "type": "number",
                  "minimum": 0
                },
                "pretax_amount": {
                  "type": "number",
                  "description": "Pre-tax total = unit_price_pretax * quantity (Thành tiền trong AMIS)."
                },
                "discount_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "discount_amount": {
                  "type": "number",
                  "minimum": 0
                },
                "discount_account": {
                  "type": "string",
                  "description": "TK Chiết khấu (e.g. 5211)."
                },
                "vat_rate": {
                  "type": "number",
                  "enum": [0, 5, 8, 10, -1],
                  "description": "VAT percentage rate (-1 for exempt/non-taxable)."
                },
                "vat_amount": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Tiền thuế GTGT."
                },
                "vat_account": {
                  "type": "string",
                  "enum": ["33311", "33312", "1331"],
                  "description": "TK Thuế GTGT."
                },
                "is_promotion": {
                  "type": "boolean",
                  "description": "True if promotional item (Hàng khuyến mại)."
                },
                "cost_item_code": {
                  "type": "string",
                  "description": "Mã khoản mục chi phí (e.g. BAOBIDONGGOI)."
                }
              },
              "required": [
                "line_no",
                "item_code",
                "quantity",
                "unit_price_pretax",
                "pretax_amount",
                "vat_rate",
                "vat_amount"
              ]
            },
            "minItems": 1
          },
          "journal_entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entry_no": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": {
                  "type": "string"
                },
                "debit_account": {
                  "type": "string",
                  "pattern": "^[0-9]{3,6}$"
                },
                "credit_account": {
                  "type": "string",
                  "pattern": "^[0-9]{3,6}$"
                },
                "amount": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "entry_no",
                "debit_account",
                "credit_account",
                "amount"
              ]
            },
            "minItems": 1
          },
          "voucher_total_debit": {
            "type": "number",
            "minimum": 0
          },
          "voucher_total_credit": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "voucher_no",
          "voucher_type",
          "posting_date",
          "voucher_date",
          "warehouse_code",
          "customer_code",
          "unit_code",
          "description",
          "vas14_compliance",
          "line_items",
          "journal_entries",
          "voucher_total_debit",
          "voucher_total_credit"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "contract_type",
    "batch_id",
    "accounting_period",
    "legal_entity",
    "accounting_regime",
    "channel",
    "summary",
    "vouchers"
  ],
