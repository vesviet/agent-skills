{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a2a-artifact",
  "title": "A2A Task Artifact",
  "description": "Deliverable returned by a worker agent (A2A Artifact / Antigravity task result).",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "ID of the original A2A task this artifact responds to."
    },
    "state": {
      "type": "string",
      "enum": [
        "submitted",
        "working",
        "input-required",
        "completed",
        "failed",
        "canceled"
      ],
      "description": "Terminal or in-progress task state mirrored on artifact."
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "blocked",
        "partial"
      ],
      "description": "Pack-level outcome status (maps to A2A terminal states)."
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "file",
              "data",
              "json"
            ]
          },
          "text": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          },
          "file_ref": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ]
      },
      "description": "A2A multimodal artifact parts."
    },
    "result": {
      "type": "object",
      "description": "Structured output conforming to output_schema_ref from the task.",
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Proof that success criteria were met."
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "criterion",
          "reason"
        ]
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "token_usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        },
        "model_used": {
          "type": "string"
        }
      }
    },
    "trace_id": {
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "status"
  ],
  "examples": [
    {
      "artifact_id": "artifact-impl-result-slice-01",
      "task_id": "task-cod-store-routing-slice-01",
      "name": "implementation-result",
      "parts": [
        {
          "type": "text",
          "text": "{\"contract_type\":\"implementation-result\",\"slice_id\":\"slice-01-command-logic\",...}"
        }
      ]
    }
  ]
}
