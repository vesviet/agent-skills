{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-tokens-spec",
  "title": "Design Tokens Specification",
  "description": "Formal JSON Schema Draft 2020-12 specifying machine-readable DESIGN.md frontmatter design tokens and standalone token specifications. Covers two-tier color palettes (OKLCH perceptual ramps and semantic mappings with APCA contrast ratings), typography hierarchy (font scales, unitless line-heights, tabular-nums for numeric grids), concentric border radii (R_outer = R_inner + padding + border_width), spacing units (4px base grid with 44px touch target guards), and multi-layer elevation/shadow definitions.",
  "type": "object",
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "design-tokens-spec",
      "description": "Machine-readable contract discriminator."
    },
    "spec_id": {
      "type": "string",
      "description": "Unique identifier, e.g. TOK-2026-10-20-core-tokens or brand-slug."
    },
    "title": {
      "type": "string",
      "description": "Human-readable title of the design token set."
    },
    "version": {
      "type": "string",
      "description": "Semantic version of the token specification (e.g. 1.0.0)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of creation or update."
    },
    "target_framework": {
      "type": "string",
      "enum": [
        "tailwind-v4",
        "css-custom-properties",
        "w3c-dtcg",
        "style-dictionary",
        "vanilla-css"
      ],
      "description": "Target CSS/styling framework or export convention."
    },
    "tier_architecture": {
      "type": "string",
      "enum": ["two-tier", "three-tier"],
      "description": "Token tier architecture standard (Tier 1 Primitives, Tier 2 Semantics, optional Tier 3 Component tokens)."
    },
    "color_palette": {
      "type": "object",
      "description": "Two-tier color system specifying Tier 1 primitives and Tier 2 semantic role assignments.",
      "properties": {
        "color_space": {
          "type": "string",
          "enum": ["oklch", "srgb", "display-p3"],
          "description": "Color model used for calculations (OKLCH preferred)."
        },
        "constant_hue_enforced": {
          "type": "boolean",
          "description": "Whether constant hue angle (delta H = 0 deg) is enforced across functional color ramps."
        },
        "lightness_delta_rules": {
          "type": "object",
          "description": "Perceptual OKLCH delta step validation criteria.",
          "properties": {
            "light_end_delta": {
              "type": "string",
              "description": "Step spacing delta L for steps 50-200 (approx 0.04-0.05)."
            },
            "mid_ramp_delta": {
              "type": "string",
              "description": "Step spacing delta L for steps 300-800 (approx 0.07-0.10)."
            },
            "distinguishability_floor": {
              "type": "number",
              "description": "Minimum delta L between adjacent steps (>= 0.03)."
            }
          }
        },
        "tier1_primitives": {
          "type": "object",
          "description": "Primitive color ramps indexed by hue/purpose (e.g., neutral, primary, accent, success, warning, danger).",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "hue_angle": {
                "type": "number",
                "minimum": 0,
                "maximum": 360
              },
              "steps": {
                "type": "object",
                "description": "11-step color scale from 50 to 950.",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "oklch": {
                      "type": "string"
                    },
                    "hex": {
                      "type": "string"
                    },
                    "lightness": {
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0
                    },
                    "chroma": {
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 0.5
                    }
                  },
                  "required": ["oklch", "hex", "lightness"]
                }
              }
            },
            "required": ["steps"]
          }
        },
        "tier2_semantics": {
          "type": "object",
          "description": "Semantic role tokens mapped to primitives for surfaces, text, borders, and interactive elements.",
          "properties": {
            "surfaces": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "light": { "type": "string" },
                  "dark": { "type": "string" },
                  "description": { "type": "string" }
                },
                "required": ["light", "dark"]
              }
            },
            "text": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "light": { "type": "string" },
                  "dark": { "type": "string" },
                  "apca_lc_target": { "type": "number" },
                  "description": { "type": "string" }
                },
                "required": ["light", "dark"]
              }
            },
            "borders": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "light": { "type": "string" },
                  "dark": { "type": "string" },
                  "description": { "type": "string" }
                },
                "required": ["light", "dark"]
              }
            },
            "interactive": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "default": { "type": "string" },
                  "hover": { "type": "string" },
                  "active": { "type": "string" },
                  "focus_ring": { "type": "string" },
                  "disabled": { "type": "string" }
                },
                "required": ["default", "hover", "active"]
              }
            }
          },
          "required": ["surfaces", "text", "borders"]
        }
      },
      "required": ["tier1_primitives", "tier2_semantics"]
    },
    "typography_hierarchy": {
      "type": "object",
      "description": "Typography scales, font families, unitless line-heights, and numeric alignment feature settings.",
      "properties": {
        "font_families": {
          "type": "object",
          "properties": {
            "sans": { "type": "string" },
            "serif": { "type": "string" },
            "mono": { "type": "string" },
            "display": { "type": "string" }
          },
          "required": ["sans", "mono"]
        },
        "font_sizes": {
          "type": "object",
          "description": "Type scale with font-size, unitless line-height, and letter-spacing.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "font_size": { "type": "string" },
              "line_height": { "type": "string" },
              "letter_spacing": { "type": "string" },
              "min_apca_lc": { "type": "number" }
            },
            "required": ["font_size", "line_height"]
          }
        },
        "font_weights": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "numeric_alignment": {
          "type": "object",
          "description": "Tabular numerals and OpenType features for data grids, financial tables, and telemetry counters.",
          "properties": {
            "tabular_nums_enforced": {
              "type": "boolean",
              "description": "Whether font-variant-numeric: tabular-nums is enforced on numeric table cells."
            },
            "font_feature_settings": {
              "type": "string",
              "description": "CSS font-feature-settings string, e.g. 'tnum' 1, 'cv02' 1."
            }
          },
          "required": ["tabular_nums_enforced"]
        }
      },
      "required": ["font_families", "font_sizes", "numeric_alignment"]
    },
    "border_radii": {
      "type": "object",
      "description": "Corner curvature scales and concentric border radius mathematical formulas.",
      "properties": {
        "scale": {
          "type": "object",
          "description": "Base radius scale tokens (none, sm, md, lg, xl, 2xl, full).",
          "additionalProperties": { "type": "string" }
        },
        "concentric_rules": {
          "type": "object",
          "description": "Concentric curvature formula: R_outer = R_inner + P + B.",
          "properties": {
            "formula": {
              "type": "string",
              "const": "R_outer = R_inner + padding + border_width"
            },
            "decoupling_threshold_px": {
              "type": "number",
              "description": "Padding threshold (default 24px) where surfaces visually decouple and independent token scales apply."
            },
            "nested_pairs": {
              "type": "array",
              "description": "Pre-calculated concentric container/child geometry pairs.",
              "items": {
                "type": "object",
                "properties": {
                  "context": { "type": "string" },
                  "inner_radius": { "type": "string" },
                  "padding": { "type": "string" },
                  "border_width": { "type": "string" },
                  "outer_radius": { "type": "string" }
                },
                "required": ["inner_radius", "padding", "border_width", "outer_radius"]
              }
            }
          },
          "required": ["formula"]
        }
      },
      "required": ["scale", "concentric_rules"]
    },
    "spacing_units": {
      "type": "object",
      "description": "Grid spacing scale and interactive touch target size guards.",
      "properties": {
        "base_unit_px": {
          "type": "number",
          "description": "Base grid increment in pixels (typically 4px)."
        },
        "scale": {
          "type": "object",
          "description": "Spacing tokens mapping step numbers to pixel or rem dimensions.",
          "additionalProperties": { "type": "string" }
        },
        "touch_target_guard": {
          "type": "object",
          "description": "Mobile touch affordance guards preventing tap targets smaller than 44px.",
          "properties": {
            "min_touch_target_px": {
              "type": "number",
              "minimum": 44,
              "description": "Minimum interactive touch target dimension (>= 44px per WCAG / iOS Human Interface Guidelines)."
            },
            "enforced_on_mobile": {
              "type": "boolean"
            }
          },
          "required": ["min_touch_target_px", "enforced_on_mobile"]
        }
      },
      "required": ["base_unit_px", "scale", "touch_target_guard"]
    },
    "elevation_shadows": {
      "type": "object",
      "description": "Layered elevation shadows and dark mode surface elevation adaptations.",
      "properties": {
        "shadow_scale": {
          "type": "object",
          "description": "Multi-layer box shadows keyed by elevation tier (none, sm, md, lg, xl, 2xl).",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "css_box_shadow": { "type": "string" },
              "description": { "type": "string" }
            },
            "required": ["css_box_shadow"]
          }
        },
        "dark_mode_elevation": {
          "type": "object",
          "description": "Surface lightness lift adjustments applied in dark mode in lieu of diffuse shadows.",
          "properties": {
            "strategy": {
              "type": "string",
              "enum": ["surface-lightness-lift", "subtle-tint-overlay", "border-glow"]
            },
            "elevation_levels": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          },
          "required": ["strategy"]
        }
      },
      "required": ["shadow_scale", "dark_mode_elevation"]
    },
    "motion_performance": {
      "type": "object",
      "description": "Motion tokens restricted to hardware-accelerated transforms and opacity with 60fps budgets.",
      "properties": {
        "hardware_accelerated_properties_only": {
          "type": "boolean",
          "description": "Enforces that continuous animations touch only transform and opacity."
        },
        "durations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "easings": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "prefers_reduced_motion_guard": {
          "type": "boolean",
          "description": "Requires instantaneous or opacity-only transitions when prefers-reduced-motion: reduce is detected."
        }
      }
    },
    "compliance_checks": {
      "type": "object",
      "description": "Verification status against Anti-UI-Slop finish gate, APCA contrast, and touch accessibility.",
      "properties": {
        "apca_contrast_verified": { "type": "boolean" },
        "concentric_geometry_verified": { "type": "boolean" },
        "touch_target_44px_verified": { "type": "boolean" },
        "tabular_nums_enforced": { "type": "boolean" },
        "state_completeness_verified": { "type": "boolean" }
      }
    }
  },
  "required": [
    "contract_type",
    "spec_id",
    "title",
    "version",
    "created_at",
    "color_palette",
    "typography_hierarchy",
    "border_radii",
    "spacing_units",
    "elevation_shadows"
  ],
  "examples": [
    {
      "contract_type": "design-tokens-spec",
      "spec_id": "TOK-2026-10-20-core-tokens",
      "title": "Core Application Design System Tokens",
      "version": "1.0.0",
      "created_at": "2026-10-20T02:40:00Z",
      "target_framework": "tailwind-v4",
      "tier_architecture": "two-tier",
      "color_palette": {
        "color_space": "oklch",
        "constant_hue_enforced": true,
        "lightness_delta_rules": {
          "light_end_delta": "0.04-0.05",
          "mid_ramp_delta": "0.07-0.10",
          "distinguishability_floor": 0.03
        },
        "tier1_primitives": {
          "neutral": {
            "hue_angle": 254.0,
            "steps": {
              "50": { "oklch": "oklch(0.98 0.005 254)", "hex": "#fafafa", "lightness": 0.98, "chroma": 0.005 },
              "100": { "oklch": "oklch(0.94 0.008 254)", "hex": "#f4f4f5", "lightness": 0.94, "chroma": 0.008 },
              "200": { "oklch": "oklch(0.89 0.012 254)", "hex": "#e4e4e7", "lightness": 0.89, "chroma": 0.012 },
              "500": { "oklch": "oklch(0.55 0.035 254)", "hex": "#71717a", "lightness": 0.55, "chroma": 0.035 },
              "900": { "oklch": "oklch(0.21 0.025 254)", "hex": "#18181b", "lightness": 0.21, "chroma": 0.025 }
            }
          },
          "primary": {
            "hue_angle": 260.0,
            "steps": {
              "50": { "oklch": "oklch(0.97 0.015 260)", "hex": "#eff6ff", "lightness": 0.97, "chroma": 0.015 },
              "600": { "oklch": "oklch(0.53 0.220 260)", "hex": "#2563eb", "lightness": 0.53, "chroma": 0.220 },
              "700": { "oklch": "oklch(0.45 0.210 260)", "hex": "#1d4ed8", "lightness": 0.45, "chroma": 0.210 }
            }
          }
        },
        "tier2_semantics": {
          "surfaces": {
            "surface-canvas": { "light": "var(--neutral-50)", "dark": "var(--neutral-900)", "description": "Base app background" },
            "surface-card": { "light": "#ffffff", "dark": "#1f1f23", "description": "Elevated card surface" }
          },
          "text": {
            "text-primary": { "light": "var(--neutral-900)", "dark": "var(--neutral-50)", "apca_lc_target": 90.0, "description": "Primary high-contrast reading text" },
            "text-muted": { "light": "var(--neutral-500)", "dark": "var(--neutral-400)", "apca_lc_target": 60.0, "description": "Secondary assistive text" }
          },
          "borders": {
            "border-subtle": { "light": "var(--neutral-200)", "dark": "var(--neutral-700)", "description": "Component dividers" }
          },
          "interactive": {
            "primary-btn": {
              "default": "var(--primary-600)",
              "hover": "var(--primary-700)",
              "active": "var(--primary-800)",
              "focus_ring": "var(--primary-300)",
              "disabled": "var(--neutral-200)"
            }
          }
        }
      },
      "typography_hierarchy": {
        "font_families": {
          "sans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace"
        },
        "font_sizes": {
          "sm": { "font_size": "0.875rem", "line_height": "1.4", "letter_spacing": "0" },
          "base": { "font_size": "1rem", "line_height": "1.5", "letter_spacing": "0" },
          "lg": { "font_size": "1.125rem", "line_height": "1.4", "letter_spacing": "-0.01em" },
          "xl": { "font_size": "1.25rem", "line_height": "1.3", "letter_spacing": "-0.02em" }
        },
        "font_weights": {
          "regular": 400,
          "medium": 500,
          "semibold": 600,
          "bold": 700
        },
        "numeric_alignment": {
          "tabular_nums_enforced": true,
          "font_feature_settings": "'tnum' 1, 'cv02' 1"
        }
      },
      "border_radii": {
        "scale": {
          "none": "0px",
          "sm": "4px",
          "md": "8px",
          "lg": "12px",
          "xl": "16px",
          "full": "9999px"
        },
        "concentric_rules": {
          "formula": "R_outer = R_inner + padding + border_width",
          "decoupling_threshold_px": 24,
          "nested_pairs": [
            {
              "context": "card-container-with-badge",
              "inner_radius": "4px",
              "padding": "16px",
              "border_width": "1px",
              "outer_radius": "21px"
            }
          ]
        }
      },
      "spacing_units": {
        "base_unit_px": 4,
        "scale": {
          "0": "0px",
          "1": "4px",
          "2": "8px",
          "3": "12px",
          "4": "16px",
          "6": "24px",
          "8": "32px",
          "12": "48px"
        },
        "touch_target_guard": {
          "min_touch_target_px": 44,
          "enforced_on_mobile": true
        }
      },
      "elevation_shadows": {
        "shadow_scale": {
          "none": { "css_box_shadow": "none", "description": "Flat surface" },
          "sm": { "css_box_shadow": "0 1px 2px 0 rgb(0 0 0 / 0.05)", "description": "Slight card lift" },
          "md": { "css_box_shadow": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)", "description": "Interactive dropdown / popover" }
        },
        "dark_mode_elevation": {
          "strategy": "surface-lightness-lift",
          "elevation_levels": {
            "card": "oklch(0.24 0.02 254)",
            "popover": "oklch(0.28 0.02 254)",
            "modal": "oklch(0.32 0.02 254)"
          }
        }
      },
      "motion_performance": {
        "hardware_accelerated_properties_only": true,
        "durations": {
          "fast": "150ms",
          "normal": "250ms"
        },
        "easings": {
          "standard": "cubic-bezier(0.2, 0, 0, 1)"
        },
        "prefers_reduced_motion_guard": true
      },
      "compliance_checks": {
        "apca_contrast_verified": true,
        "concentric_geometry_verified": true,
        "touch_target_44px_verified": true,
        "tabular_nums_enforced": true,
        "state_completeness_verified": true
      }
    }
  ]
}
