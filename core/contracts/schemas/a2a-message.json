{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a2a-message",
  "title": "A2A Message",
  "description": "Single message in an A2A task conversation history.",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "agent",
        "system",
        "delegator",
        "worker"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "parts": {
      "type": "array",
      "description": "A2A multimodal message parts (A2A v1.0 unified Part model discriminated by member presence).",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Textual content of the part."
          },
          "data": {
            "type": "object",
            "description": "Structured JSON data payload.",
            "additionalProperties": true
          },
          "file": {
            "type": "object",
            "description": "File payload or metadata object.",
            "additionalProperties": true
          },
          "file_ref": {
            "type": "string",
            "description": "URI or relative path reference to file content."
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "file",
              "data",
              "json"
            ],
            "description": "Legacy discriminator from A2A v0.x (optional for backwards compatibility; v1.0 discriminates by member presence)."
          },
          "metadata": {
            "type": "object",
            "description": "Optional part-level metadata or annotations.",
            "additionalProperties": true
          }
        },
        "anyOf": [
          {
            "required": [
              "text"
            ]
          },
          {
            "required": [
              "data"
            ]
          },
          {
            "required": [
              "file"
            ]
          },
          {
            "required": [
              "file_ref"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "message_id",
    "role",
    "parts"
  ],
  "examples": [
    {
      "message_id": "msg-001",
      "role": "agent",
      "timestamp": "2026-06-12T11:45:00Z",
      "parts": [
        {
          "text": "slice-01 completed. See implementation-result.json."
        }
      ]
    }
  ]
}
