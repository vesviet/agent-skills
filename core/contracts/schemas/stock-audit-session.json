{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stock-audit-session",
  "title": "Stock Audit Session Contract",
  "description": "Physical inventory stocktake contract governing the entire audit lifecycle (draft, in_progress, review, recount, closed), offline PWA/HID barcode event streams, tolerance thresholds, anti-anchoring blind recounts, variance reconciliation, TK 1381/3381 suspense accounting, and multi-tier approval sign-offs.",
  "type": "object",
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "stock-audit-session",
      "description": "Machine-readable contract discriminator."
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,100}$",
      "description": "Unique session identifier (e.g. AUDIT-2026-Q3-STORE-HN01)."
    },
    "store_code": {
      "type": "string",
      "description": "Store or retail warehouse code (e.g. CH009, CH060, CH077)."
    },
    "store_name": {
      "type": "string"
    },
    "audit_type": {
      "type": "string",
      "enum": ["full", "cycle"],
      "description": "Full physical inventory count or cycle count."
    },
    "lifecycle_status": {
      "type": "string",
      "enum": ["draft", "in_progress", "review", "recount", "closed"],
      "description": "Current lifecycle status of the physical stocktake session."
    },
    "created_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "tolerance_config": {
      "type": "object",
      "properties": {
        "tolerance_units": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "tolerance_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 2.0
        },
        "high_value_threshold_vnd": {
          "type": "number",
          "minimum": 0,
          "default": 500000
        },
        "discrepancy_ratio_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.05
        }
      },
      "required": ["tolerance_units", "tolerance_pct"]
    },
    "scan_events_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Authoritative server-recorded timestamp."
          },
          "client_timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Client device timestamp when barcode was read."
          },
          "barcode": {
            "type": "string",
            "description": "Scanned barcode or SKU identifier."
          },
          "product_name": {
            "type": "string"
          },
          "scanner_id": {
            "type": "string",
            "description": "User ID of counting personnel."
          },
          "method": {
            "type": "string",
            "enum": ["pwa_camera", "hid_scanner", "keyboard", "rfid", "manual"]
          },
          "event_type": {
            "type": "string",
            "enum": ["scan", "undo", "manual_entry", "extra_sku_scan", "recount_scan"]
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          },
          "condition_flag": {
            "type": "string",
            "enum": ["normal", "damaged", "misplace", "expired", "stolen", "in_transit", "sample"],
            "default": "normal"
          },
          "location_code": {
            "type": "string",
            "description": "Shelf, aisle, or bin code."
          },
          "approval_status": {
            "type": "string",
            "enum": ["approved", "pending_approval", "rejected"],
            "default": "approved"
          },
          "offline_duration_sec": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "event_id",
          "timestamp",
          "barcode",
          "scanner_id",
          "method",
          "event_type",
          "qty"
        ]
      }
    },
    "reconciliation_summary": {
      "type": "object",
      "properties": {
        "total_expected_skus": {
          "type": "integer",
          "minimum": 0
        },
        "total_scanned_skus": {
          "type": "integer",
          "minimum": 0
        },
        "match_count": {
          "type": "integer",
          "minimum": 0
        },
        "short_count": {
          "type": "integer",
          "minimum": 0
        },
        "over_count": {
          "type": "integer",
          "minimum": 0
        },
        "not_counted_count": {
          "type": "integer",
          "minimum": 0
        },
        "extra_count": {
          "type": "integer",
          "minimum": 0
        },
        "accuracy_rate_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "total_expected_value_vnd": {
          "type": "number",
          "minimum": 0
        },
        "total_actual_value_vnd": {
          "type": "number",
          "minimum": 0
        },
        "net_variance_value_vnd": {
          "type": "number"
        },
        "total_cogs_loss_vnd": {
          "type": "number",
          "minimum": 0,
          "description": "Total Value-at-Risk from damaged and missing inventory."
        }
      },
      "required": [
        "total_expected_skus",
        "total_scanned_skus",
        "match_count",
        "short_count",
        "over_count",
        "accuracy_rate_pct",
        "net_variance_value_vnd"
      ]
    },
    "items_variance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "expected_qty": {
            "type": "integer",
            "minimum": 0
          },
          "actual_qty": {
            "type": "integer",
            "minimum": 0
          },
          "recount_qty": {
            "type": "integer",
            "minimum": 0
          },
          "variance": {
            "type": "integer",
            "description": "actual_qty - expected_qty."
          },
          "variance_pct": {
            "type": "number"
          },
          "category": {
            "type": "string",
            "enum": ["MATCH", "OVER", "SHORT", "NOT_COUNTED", "EXTRA"]
          },
          "cost_price_vnd": {
            "type": "number",
            "minimum": 0
          },
          "cogs_loss_vnd": {
            "type": "number",
            "minimum": 0
          },
          "recount_flagged": {
            "type": "boolean"
          },
          "review_status": {
            "type": "string",
            "enum": ["pending", "resolved", "recount_requested", "approved"]
          }
        },
        "required": [
          "sku",
          "expected_qty",
          "actual_qty",
          "variance",
          "category",
          "recount_flagged"
        ]
      }
    },
    "accounting_adjustments": {
      "type": "object",
      "properties": {
        "shortage_suspense_1381": {
          "type": "object",
          "properties": {
            "debit_account": {
              "type": "string",
              "const": "1381"
            },
            "credit_account": {
              "type": "string",
              "const": "1561"
            },
            "amount_vnd": {
              "type": "number",
              "minimum": 0
            },
            "explanation": {
              "type": "string"
            }
          },
          "required": ["debit_account", "credit_account", "amount_vnd"]
        },
        "surplus_suspense_3381": {
          "type": "object",
          "properties": {
            "debit_account": {
              "type": "string",
              "const": "1561"
            },
            "credit_account": {
              "type": "string",
              "const": "3381"
            },
            "amount_vnd": {
              "type": "number",
              "minimum": 0
            },
            "explanation": {
              "type": "string"
            }
          },
          "required": ["debit_account", "credit_account", "amount_vnd"]
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "counter",
              "store_manager",
              "chief_accountant",
              "legal_representative"
            ]
          },
          "approver_id": {
            "type": "string"
          },
          "approver_name": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": ["approved", "rejected", "recount_requested"]
          },
          "signed_at": {
            "type": "string",
            "format": "date-time"
          },
          "signature_token": {
            "type": "string",
            "description": "Cryptographic sign-off token."
          },
          "comments": {
            "type": "string"
          }
        },
        "required": [
          "level",
          "approver_id",
          "approver_name",
          "decision",
          "signed_at",
          "signature_token"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "contract_type",
    "session_id",
    "store_code",
    "store_name",
    "audit_type",
    "lifecycle_status",
    "created_by",
    "created_at",
    "tolerance_config",
    "reconciliation_summary",
    "items_variance",
    "approvals"
  ],
  "examples": [
