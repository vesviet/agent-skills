{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deployment-plan",
  "title": "Deployment Plan",
  "description": "Structured output for a deployment strategy and execution plan.",
  "type": "object",
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "deployment-plan",
      "description": "Machine-readable contract discriminator."
    },
    "version": {
      "type": "string",
      "description": "Version tag or commit hash being deployed."
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Target environments (e.g., staging, production)."
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "order": {
            "type": "integer"
          },
          "action": {
            "type": "string"
          },
          "is_destructive": {
            "type": "boolean"
          },
          "owner": {
            "type": "string"
          }
        },
        "required": [
          "order",
          "action",
          "is_destructive"
        ]
      },
      "description": "Ordered sequence of deployment steps."
    },
    "rollback_plan": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "revert_commit",
            "previous_image",
            "feature_flag_off",
            "manual_restore"
          ]
        },
        "estimated_time_mins": {
          "type": "integer"
        },
        "data_loss_risk": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "high"
          ]
        }
      },
      "required": [
        "strategy",
        "data_loss_risk"
      ]
    },
    "smoke_tests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Post-deployment checks to verify health."
    },
    "gitops_compliance": {
      "type": "object",
      "description": "GitOps discipline adherence.",
      "properties": {
        "drift_detection_configured": {
          "type": "boolean",
          "description": "Whether automated drift detection is active for this infrastructure."
        },
        "iac_repo_ref": {
          "type": "string",
          "description": "Repository or path where the infrastructure state is declared."
        }
      },
      "required": [
        "drift_detection_configured"
      ]
    },
    "supply_chain_security": {
      "type": "object",
      "description": "SLSA and supply chain security compliance.",
      "properties": {
        "sbom_generated": {
          "type": "boolean"
        },
        "dependencies_pinned_to_sha": {
          "type": "boolean",
          "description": "Third-party CI actions and tools use pinned commit SHAs, not mutable tags."
        },
        "vulnerability_scan_passed": {
          "type": "boolean",
          "description": "CI dependency scan passed with no un-waivered critical/high CVEs."
        }
      },
      "required": [
        "sbom_generated",
        "dependencies_pinned_to_sha",
        "vulnerability_scan_passed"
      ]
    },
    "ai_ml_deployment": {
      "type": "object",
      "description": "Specific deployment controls for AI/ML models. Omit if not deploying a model.",
      "properties": {
        "shadow_testing_completed": {
          "type": "boolean"
        },
        "automatic_rollback_triggers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Model-specific triggers (e.g. latency P99, output quality score)."
        },
        "cold_start_latency_ms": {
          "type": "integer"
        },
        "monitoring_deployed": {
          "type": "boolean",
          "description": "True if model monitoring (drift, token cost, etc) is live."
        }
      }
    },
    "verification": {
      "type": "object",
      "description": "Post-deployment health checks and observability.",
      "properties": {
        "health_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dashboards_or_logs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "smoke_tests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Post-deployment checks to verify health."
        }
      }
    }
  },
  "required": [
    "contract_type",
    "version",
    "environments",
    "steps",
    "rollback_plan"
  ],
  "examples": [
    {
      "contract_type": "deployment-plan",
      "plan_id": "2026-06-12-cod-store-order",
      "service": "DMS orders-service",
      "environment": "staging",
      "version": "v1.4.2-cod-routing",
      "steps": [
        {
          "order": 1,
          "action": "Run database migration check (none required)",
          "is_destructive": false,
          "owner": "devops-engineer"
        },
        {
          "order": 2,
          "action": "Deploy to staging via CI pipeline",
          "is_destructive": false,
          "owner": "devops-engineer"
        },
        {
          "order": 3,
          "action": "Run smoke test: assign COD order to store 42",
          "is_destructive": false,
          "owner": "qa-engineer"
        },
        {
          "order": 4,
          "action": "Promote to production on QA sign-off",
          "is_destructive": false,
          "owner": "devops-engineer"
        }
      ],
      "rollback_plan": "Revert deployment to previous build. No migration rollback required.",
      "monitoring": "Watch order assignment error rate for 30 min post-deploy. Alert if > 0.5%."
    }
  ]
}