{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "performance-audit",
  "title": "Performance Audit Result",
  "description": "Structured output for a frontend or 3D performance audit.",
  "type": "object",
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "performance-audit",
      "description": "Machine-readable contract discriminator."
    },
    "target": {
      "type": "string",
      "description": "Page, route, scene, or component being audited."
    },
    "metrics": {
      "type": "object",
      "properties": {
        "lcp_ms": {
          "type": "number",
          "description": "Largest Contentful Paint in milliseconds."
        },
        "fid_ms": {
          "type": "number",
          "description": "First Input Delay in milliseconds."
        },
        "cls": {
          "type": "number",
          "description": "Cumulative Layout Shift score."
        },
        "ttfb_ms": {
          "type": "number",
          "description": "Time to First Byte in milliseconds."
        },
        "fps": {
          "type": "number",
          "description": "Frames per second (for 3D scenes)."
        },
        "memory_mb": {
          "type": "number",
          "description": "Peak memory usage in MB."
        },
        "draw_calls": {
          "type": "integer",
          "description": "Number of draw calls (for 3D scenes)."
        },
        "bundle_size_kb": {
          "type": "number",
          "description": "Total JS bundle size in KB."
        }
      },
      "description": "Measured performance metrics."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "recommendation": {
            "type": "string"
          }
        },
        "required": [
          "issue",
          "severity",
          "recommendation"
        ]
      }
    },
    "device_profile": {
      "type": "string",
      "description": "Device or profile used for testing (e.g. 'Desktop Chrome', 'Mobile Safari', 'Low-end Android')."
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "conditional_pass",
        "fail"
      ],
      "description": "Overall performance verdict."
    }
  },
  "required": [
    "contract_type",
    "target",
    "findings",
    "verdict"
  ],
  "examples": [
    {
      "contract_type": "performance-audit",
      "audit_id": "2026-06-12-order-assign-command-perf",
      "component": "orders-service/NewLogicAutoAssign.php",
      "baseline_p95_ms": 210,
      "current_p95_ms": 340,
      "regression_detected": true,
      "findings": [
        {
          "finding": "Store courier lookup adds ~130ms per COD order due to N+1 query pattern",
          "severity": "high",
          "recommendation": "Batch store_id lookups; cache active store courier IDs for 60s"
        }
      ],
      "action_items": [
        "Add batch lookup in NewLogicAutoAssign.php store query"
      ]
    }
  ]
}
