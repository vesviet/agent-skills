{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a2a-jsonrpc-envelope",
  "title": "A2A JSON-RPC 2.0 Envelope",
  "description": "Wire-format wrapper for A2A operations (agent.invoke, agent.stream, tasks/get, tasks/cancel).",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "type": "string",
      "const": "2.0"
    },
    "id": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        }
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "agent.invoke",
        "agent.stream",
        "tasks/get",
        "tasks/list",
        "tasks/cancel",
        "agent/getCard"
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  },
  "required": [
    "jsonrpc"
  ],
  "examples": [
    {
      "jsonrpc": "2.0",
      "id": "req-001",
      "method": "tasks/send",
      "params": {
        "id": "task-001"
      }
    }
  ]
}
