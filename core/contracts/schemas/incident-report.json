{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "incident-report",
  "title": "Incident Report",
  "description": "Structured output for SRE incident response and post-mortems.",
  "type": "object",
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "incident-report",
      "description": "Machine-readable contract discriminator."
    },
    "incident_id": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "SEV-1",
        "SEV-2",
        "SEV-3",
        "SEV-4"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "investigating",
        "mitigated",
        "resolved"
      ]
    },
    "impact": {
      "type": "object",
      "properties": {
        "user_facing": {
          "type": "boolean"
        },
        "services_affected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "downtime_minutes": {
          "type": "integer"
        }
      },
      "required": [
        "user_facing"
      ]
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "event": {
            "type": "string"
          }
        },
        "required": [
          "timestamp",
          "event"
        ]
      }
    },
    "root_cause": {
      "type": "string",
      "description": "Identified root cause (or hypothesized if investigating)."
    },
    "mitigation_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string"
          },
          "owner_role": {
            "type": "string"
          },
          "ticket_ref": {
            "type": "string"
          }
        },
        "required": [
          "task",
          "owner_role"
        ]
      }
    },
    "ai_hallucination_factor": {
      "type": "boolean",
      "description": "True if an AI hallucination or unverified AI output contributed to the incident."
    }
  },
  "required": [
    "contract_type",
    "severity",
    "status",
    "impact",
    "timeline"
  ],
  "examples": [
    {
      "contract_type": "incident-report",
      "incident_id": "INC-2026-06-12-order-assign-failure",
      "severity": "SEV-2",
      "started_at": "2026-06-12T10:00:00+07:00",
      "resolved_at": "2026-06-12T10:45:00+07:00",
      "title": "COD order assignment failing for store 42 due to store-service 503",
      "summary": "Store service returned 503 for 45 minutes. COD orders fell back to warehouse courier. No data loss. Alert fired at P95 latency spike.",
      "timeline": [
        {
          "time": "10:00",
          "event": "Store-service 503 rate exceeds 20%; order assignment alerts fire"
        },
        {
          "time": "10:15",
          "event": "SRE confirms store-service memory OOM; restart initiated"
        },
        {
          "time": "10:45",
          "event": "Store-service recovered; COD routing resumed"
        }
      ],
      "root_cause": "Store-service OOM due to unindexed query on store_couriers table under batch load",
      "impact": "89 COD orders assigned to warehouse courier instead of store courier during 45-min window",
      "action_items": [
        "Add index on store_couriers.store_id (Data Engineer)",
        "Add store-service circuit breaker to COD routing (Backend Developer)"
      ],
      "status": "resolved"
    }
  ]
}
