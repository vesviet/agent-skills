{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-assessment-report",
  "title": "Learning Assessment Report",
  "description": "Structured machine-readable report for student competency assessment, 4-tier rubric breakdowns, cognitive error diagnoses, growth mindset feedback, and HITL verification metadata.",
  "type": "object",
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "learning-assessment-report"
    },
    "assessment_id": {
      "type": "string",
      "description": "Unique assessment report identifier (e.g., ASMT-2026-CS-0941)."
    },
    "student_token": {
      "type": "string",
      "pattern": "^STU-[A-Za-z0-9_-]+$",
      "description": "Pseudonymous student token protecting privacy per FERPA and zero-PII standards."
    },
    "subject": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "curriculum_standard": {
      "type": "string"
    },
    "assessment_type": {
      "type": "string",
      "enum": ["diagnostic", "formative", "summative", "benchmark"]
    },
    "dok_level_evaluated": {
      "type": "string",
      "enum": ["dok_1", "dok_2", "dok_3", "dok_4"]
    },
    "overall_score": {
      "type": "object",
      "properties": {
        "raw_score": { "type": "number", "minimum": 0 },
        "max_score": { "type": "number", "minimum": 0 },
        "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "proficiency_tier": {
          "type": "string",
          "enum": ["beginning", "developing", "proficient", "advanced"]
        }
      },
      "required": ["raw_score", "max_score", "percentage", "proficiency_tier"]
    },
    "rubric_breakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_name": { "type": "string" },
          "points_awarded": { "type": "number", "minimum": 0 },
          "max_points": { "type": "number", "minimum": 0 },
          "tier": {
            "type": "string",
            "enum": ["beginning", "developing", "proficient", "advanced"]
          },
          "evidence_citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "submission_line_reference": { "type": "string" },
                "verbatim_quote": { "type": "string" },
                "evaluator_note": { "type": "string" }
              },
              "required": ["submission_line_reference", "verbatim_quote", "evaluator_note"]
            }
          },
          "grading_hallucination_check": {
            "type": "string",
            "enum": ["verified_against_source", "source_citation_confirmed"]
          }
        },
        "required": [
          "criterion_name",
          "points_awarded",
          "max_points",
          "tier",
          "evidence_citations",
          "grading_hallucination_check"
        ]
      },
      "minItems": 1
    },
    "cognitive_error_diagnosis": {
      "type": "object",
      "properties": {
        "primary_misconception": { "type": "string" },
        "error_category": {
          "type": "string",
          "enum": [
            "conceptual_misunderstanding",
            "procedural_execution_error",
            "boundary_edge_case_blindspot",
            "cognitive_overload_interference",
            "none"
          ]
        },
        "observed_misconception_evidence": { "type": "string" },
        "remediation_strategy": { "type": "string" }
      },
      "required": [
        "primary_misconception",
        "error_category",
        "observed_misconception_evidence",
        "remediation_strategy"
      ]
    },
    "growth_mindset_feedback": {
      "type": "object",
      "properties": {
        "effort_strategy_praise": { "type": "string" },
        "not_yet_framing": { "type": "string" },
        "rule_of_one_next_step": {
          "type": "string",
          "description": "Strictly 1 actionable remediation step to prevent cognitive overload."
        },
        "socratic_probing_question": { "type": "string" }
      },
      "required": [
        "effort_strategy_praise",
        "not_yet_framing",
        "rule_of_one_next_step",
        "socratic_probing_question"
      ]
    },
    "zpd_progression": {
      "type": "object",
      "properties": {
        "prior_theta_estimate": { "type": "number" },
        "updated_theta_estimate": { "type": "number" },
        "success_rate_moving_average": { "type": "number", "minimum": 0, "maximum": 1 },
        "recommended_next_challenge": { "type": "string" }
      },
      "required": [
        "prior_theta_estimate",
        "updated_theta_estimate",
        "success_rate_moving_average",
        "recommended_next_challenge"
      ]
    },
    "spaced_repetition_triggers": {
      "type": "object",
      "properties": {
        "next_review_due": { "type": "string", "format": "date" },
        "current_interval_days": { "type": "integer", "minimum": 1 },
        "easiness_factor": { "type": "number", "minimum": 1.3 }
      },
      "required": ["next_review_due", "current_interval_days", "easiness_factor"]
    },
    "audit_metadata": {
      "type": "object",
      "properties": {
        "graded_by_ai": { "type": "boolean" },
        "reviewed_by": { "type": "string" },
        "ai_model": { "type": "string" },
        "verification_status": {
          "type": "string",
          "enum": ["verified_and_approved", "flagged_for_revision", "escalated_to_senior_educator"]
        },
        "verification_timestamp": { "type": "string", "format": "date-time" },
        "human_reviewer_comments": { "type": "string" }
      },
      "required": [
        "graded_by_ai",
        "reviewed_by",
        "ai_model",
        "verification_status",
        "verification_timestamp",
        "human_reviewer_comments"
      ]
    },
    "privacy_compliance": {
      "type": "object",
      "properties": {
        "pii_redacted": { "type": "boolean", "const": true },
        "ferpa_compliant": { "type": "boolean", "const": true }
      },
      "required": ["pii_redacted", "ferpa_compliant"]
    }
  },
  "required": [
    "contract_type",
    "assessment_id",
    "student_token",
    "subject",
    "topic",
    "assessment_type",
    "overall_score",
    "rubric_breakdown",
    "cognitive_error_diagnosis",
    "growth_mindset_feedback",
    "audit_metadata",
    "privacy_compliance"
  ],
  "examples": [
    {
      "contract_type": "learning-assessment-report",
      "assessment_id": "ASMT-2026-CS-0941",
      "student_token": "STU-8f2e-2027",
      "subject": "Computer Science",
      "topic": "Concurrency and Thread Safety in Distributed Systems",
      "curriculum_standard": "SWE-CONC-2027.3",
      "assessment_type": "formative",
      "dok_level_evaluated": "dok_3",
      "overall_score": {
        "raw_score": 85,
        "max_score": 100,
        "percentage": 85,
        "proficiency_tier": "proficient"
      },
      "rubric_breakdown": [
        {
          "criterion_name": "Race Condition Identification & Defense",
          "points_awarded": 45,
          "max_points": 50,
          "tier": "proficient",
          "evidence_citations": [
            {
              "submission_line_reference": "lines 34-41",
              "verbatim_quote": "sync.Mutex used around order state mutation; double check locking implemented",
              "evaluator_note": "Correctly protects state mutation but read-path defer unlock introduces small contention overhead."
            }
          ],
          "grading_hallucination_check": "verified_against_source"
        },
        {
          "criterion_name": "Adversarial Stress Test Authoring",
          "points_awarded": 40,
          "max_points": 50,
          "tier": "proficient",
          "evidence_citations": [
            {
              "submission_line_reference": "lines 62-78",
              "verbatim_quote": "for i := 0; i < 100; i++ { go func() { order.Process() }() }",
              "evaluator_note": "Good concurrency stress loop, missing sync.WaitGroup.Wait before asserting final inventory balance."
            }
          ],
          "grading_hallucination_check": "source_citation_confirmed"
        }
      ],
      "cognitive_error_diagnosis": {
        "primary_misconception": "Omission of synchronization rendezvous barrier in test assertion phase",
        "error_category": "boundary_edge_case_blindspot",
        "observed_misconception_evidence": "Asserting balance immediately after spawning goroutines without waiting on sync.WaitGroup.",
        "remediation_strategy": "Trace goroutine scheduling timelines using trace tool and add sync.WaitGroup wait barrier."
      },
      "growth_mindset_feedback": {
        "effort_strategy_praise": "Exceptional decomposition of the race condition using double-check mutex locking in the main transaction loop!",
        "not_yet_framing": "You haven't fully synchronized the asynchronous test harness with the main thread yet.",
        "rule_of_one_next_step": "Add a sync.WaitGroup to your test function to ensure all 100 client goroutines finish before asserting inventory count.",
        "socratic_probing_question": "What happens to the inventory assertion if goroutine 99 executes 5 milliseconds after the test function returns?"
      },
      "zpd_progression": {
        "prior_theta_estimate": 1.25,
        "updated_theta_estimate": 1.48,
        "success_rate_moving_average": 0.78,
        "recommended_next_challenge": "DOK 3 Deadlock prevention using lock-order graphs"
      },
      "spaced_repetition_triggers": {
        "next_review_due": "2026-09-12",
        "current_interval_days": 7,
        "easiness_factor": 2.5
      },
      "audit_metadata": {
        "graded_by_ai": true,
        "reviewed_by": "Dr. Sarah Chen (Senior Faculty ID 4401)",
        "ai_model": "gemini-2.5-pro",
        "verification_status": "verified_and_approved",
        "verification_timestamp": "2026-09-05T08:00:00Z",
        "human_reviewer_comments": "Verified line citations and approved feedback. Rule of One adhered to."
      },
      "privacy_compliance": {
        "pii_redacted": true,
        "ferpa_compliant": true
      }
    }
  ]
}
