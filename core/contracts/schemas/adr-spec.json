{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adr-spec",
  "title": "Architecture Decision Record",
  "description": "Structured output for an Architecture Decision Record (ADR).",
  "type": "object",
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "adr-spec"
    },
    "title": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["proposed", "accepted", "rejected", "superseded"]
    },
    "feature_ticket_ref": { "type": "string" },
    "architecture_options_ref": {
      "type": "string",
      "description": "Path to architecture-options.json when options analysis preceded this ADR."
    },
    "supersedes_adr": {
      "type": "string",
      "description": "Title or id of ADR this record replaces."
    },
    "context": { "type": "string" },
    "affected_services": {
      "type": "array",
      "items": { "type": "string" }
    },
    "api_contract_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths or ids of api-contract-spec.json artifacts impacted."
    },
    "options_considered": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "option": { "type": "string" },
          "pros": { "type": "array", "items": { "type": "string" } },
          "cons": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["option"]
      }
    },
    "decision": { "type": "string" },
    "consequences": {
      "type": "object",
      "properties": {
        "positive": { "type": "array", "items": { "type": "string" } },
        "negative": { "type": "array", "items": { "type": "string" } }
      }
    },
    "migration_plan": { "type": "string" },
    "rollback_plan": { "type": "string" }
  },
  "required": ["title", "status", "context", "options_considered", "decision", "consequences"]
}
