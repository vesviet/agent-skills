{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-card",
  "title": "A2A Agent Card",
  "description": "Self-describing manifest for agent discovery (A2A 1.0 / Antigravity). Publish at /.well-known/agent-card.json per role or use pack registry.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Stable agent identifier (matches role slug)."
    },
    "description": {
      "type": "string",
      "description": "Human-readable capability summary."
    },
    "url": {
      "type": "string",
      "description": "Endpoint URL or pack-local role reference (pack://agent-skills/core/roles/<role>.md)."
    },
    "version": {
      "type": "string",
      "description": "Agent card semver."
    },
    "protocol_version": {
      "type": "string",
      "const": "1.0"
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "streaming": {
          "type": "boolean",
          "default": true
        },
        "pushNotifications": {
          "type": "boolean",
          "default": false
        },
        "stateTransitionHistory": {
          "type": "boolean",
          "default": true
        },
        "securityCardSigning": {
          "type": "boolean",
          "default": false,
          "description": "Whether this agent supports A2A 1.0 cryptographic security card signing."
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "default": 30000,
          "description": "Default maximum task execution duration in milliseconds supported by this agent."
        },
        "retry_policy": {
          "type": "object",
          "description": "Resilient retry strategy supported by this agent.",
          "properties": {
            "max_retries": {
              "type": "integer",
              "minimum": 0,
              "default": 3,
              "description": "Maximum number of retry attempts."
            },
            "initial_interval_ms": {
              "type": "integer",
              "minimum": 100,
              "default": 1000,
              "description": "Initial backoff delay in milliseconds."
            },
            "backoff_factor": {
              "type": "number",
              "minimum": 1.0,
              "default": 2.0,
              "description": "Multiplier for exponential backoff between retries."
            },
            "max_interval_ms": {
              "type": "integer",
              "minimum": 1000,
              "default": 30000,
              "description": "Maximum delay ceiling between retries in milliseconds."
            },
            "retryable_errors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Error codes or failure categories eligible for retry."
            },
            "jitter": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "none",
                    "full",
                    "equal"
                  ]
                }
              ],
              "default": true,
              "description": "Whether or which jitter strategy to apply (boolean or enum ['none', 'full', 'equal'])."
            }
          }
        }
      },
      "required": [
        "streaming",
        "stateTransitionHistory"
      ]
    },
    "authentication": {
      "type": "object",
      "properties": {
        "schemes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Bearer",
              "none",
              "pack-local"
            ]
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputModes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "text",
                "file",
                "data",
                "json"
              ]
            }
          },
          "outputModes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "text",
                "file",
                "data",
                "json"
              ]
            }
          },
          "output_schema_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "JSON Schema filenames this skill may produce."
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ]
      }
    },
    "defaultOutputSchemas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Default handoff schemas for this role."
    },
    "role_file": {
      "type": "string",
      "description": "Path to role definition in agent-skills pack."
    },
    "policy_profile": {
      "type": "string",
      "description": "Key in action-boundaries.yaml for this role."
    },
    "signature": {
      "type": "object",
      "description": "Optional JWS signature for A2A 1.0 signed Agent Cards (enterprise).",
      "properties": {
        "alg": {
          "type": "string",
          "enum": [
            "RS256",
            "ES256"
          ]
        },
        "jws": {
          "type": "string",
          "description": "Compact JWS over canonical card JSON."
        },
        "key_id": {
          "type": "string"
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ap2_capabilities": {
      "type": "object",
      "description": "Agent Payments Protocol (AP2) capabilities — A2A sub-protocol launched April 2026 for agent-to-agent economic transactions.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether this agent supports AP2 payment flows."
        },
        "accepted_currencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Currency codes this agent can accept (e.g. ['USD', 'USDC'])."
        },
        "payment_endpoint": {
          "type": "string",
          "format": "uri",
          "description": "AP2 payment endpoint URL. Required when enabled=true."
        },
        "max_transaction_usd": {
          "type": "number",
          "description": "Maximum transaction value in USD this agent will autonomously approve. Transactions above this require human approval."
        }
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1000,
      "default": 30000,
      "description": "Default maximum task execution duration in milliseconds advertised by this agent."
    },
    "retry_policy": {
      "type": "object",
      "description": "Default resilient retry policy supported or recommended by this agent.",
      "properties": {
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "default": 3,
          "description": "Maximum number of retry attempts."
        },
        "initial_interval_ms": {
          "type": "integer",
          "minimum": 100,
          "default": 1000,
          "description": "Initial backoff delay in milliseconds."
        },
        "backoff_factor": {
          "type": "number",
          "minimum": 1.0,
          "default": 2.0,
          "description": "Multiplier for exponential backoff between retries."
        },
        "max_interval_ms": {
          "type": "integer",
          "minimum": 1000,
          "default": 30000,
          "description": "Maximum delay ceiling between retries in milliseconds."
        },
        "retryable_errors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Error codes or failure categories eligible for retry."
        },
        "jitter": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "none",
                "full",
                "equal"
              ]
            }
          ],
          "default": true,
          "description": "Whether or which jitter strategy to apply (boolean or enum ['none', 'full', 'equal'])."
        }
      }
    }
  },
  "required": [
    "name",
    "description",
    "url",
    "version",
    "protocol_version",
    "capabilities",
    "skills"
  ],
  "examples": [
    {
      "name": "Backend Developer Agent",
      "description": "Implements backend features, APIs, and migrations following principal engineering standards",
      "url": "https://api.personalized.dev/agents/backend-developer",
      "version": "3.4.0",
      "skills": [
        {
          "id": "add-api-endpoint",
          "name": "Add API Endpoint",
          "description": "Add a new API endpoint with business logic, validation, and tests"
        },
        {
          "id": "create-migration",
          "name": "Create Migration",
          "description": "Create and validate a database schema migration"
        }
      ],
      "defaultInputModes": [
        "text/plain",
        "application/json"
      ],
      "defaultOutputModes": [
        "text/plain",
        "application/json"
      ],
      "protocol_version": "1.0",
      "capabilities": {
        "streaming": true,
        "stateTransitionHistory": true,
        "timeout_ms": 30000,
        "retry_policy": {
          "max_retries": 3,
          "initial_interval_ms": 1000,
          "backoff_factor": 2.0,
          "max_interval_ms": 30000,
          "retryable_errors": [
            "TIMEOUT",
            "RATE_LIMITED"
          ],
          "jitter": "full"
        }
      },
      "timeout_ms": 30000,
      "retry_policy": {
        "max_retries": 3,
        "initial_interval_ms": 1000,
        "backoff_factor": 2.0,
        "max_interval_ms": 30000,
        "retryable_errors": [
          "TIMEOUT",
          "RATE_LIMITED"
        ],
        "jitter": "full"
      }
    }
  ]
}
