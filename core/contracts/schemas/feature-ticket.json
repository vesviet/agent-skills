{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feature-ticket",
  "title": "Feature Ticket Specification",
  "description": "Structured output for a parsed and actionable feature ticket.",
  "type": "object",
  "properties": {
    "title": { "type": "string" },
    "type": { "type": "string", "enum": ["feature", "bug", "chore", "spike"] },
    "business_value": { "type": "string" },
    "actors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenario": { "type": "string" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" }
        },
        "required": ["scenario", "then"]
      }
    },
    "edge_cases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "out_of_scope": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["title", "type", "acceptance_criteria"]
}
