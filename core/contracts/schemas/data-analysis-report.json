{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data-analysis-report",
  "title": "Data Analysis Report",
  "description": "Structured analyst deliverable for metrics, findings, and recommendations.",
  "type": "object",
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "data-analysis-report"
    },
    "business_question": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "grain": {
            "type": "string"
          },
          "time_range": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "definition"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path_or_table": {
            "type": "string"
          },
          "as_of": {
            "type": "string"
          },
          "limitations": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "path_or_table"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interpretation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_quality_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths to Excel, charts, or query exports."
    },
    "ai_hallucination_disclaimer": {
      "type": "boolean",
      "description": "True if the data analysis involved AI data extraction and includes a verifiable confidence interval."
    }
  },
  "required": [
    "contract_type",
    "business_question",
    "metrics",
    "sources",
    "findings",
    "confidence"
  ],
  "examples": [
    {
      "contract_type": "data-analysis-report",
      "report_id": "2026-06-12-cod-order-failure-analysis",
      "feature_ticket_ref": "2026-06-12-change-store-order-cod",
      "question": "How often do COD store orders fail due to warehouse routing vs store routing mismatch?",
      "period": "2026-05-01 to 2026-06-11",
      "findings": [
        {
          "metric": "COD orders with store_id mis-routed to warehouse",
          "value": "34%",
          "context": "Of all COD+store orders in the period"
        },
        {
          "metric": "Delivery failure rate for mis-routed COD orders",
          "value": "18%",
          "context": "vs 6% for correctly routed orders"
        }
      ],
      "recommendation": "Implement COD store routing to reduce delivery failure rate by estimated 12 percentage points",
      "caveats": [
        "Analysis based on store_id field which was only 60% filled pre-Q2"
      ],
      "visualizations": [
        "bar_chart: COD routing by month",
        "funnel: mis-routing → delivery failure"
      ],
      "business_question": "What changed in the selected metric?",
      "metrics": [],
      "sources": [],
      "confidence": "Medium"
    }
  ]
}
