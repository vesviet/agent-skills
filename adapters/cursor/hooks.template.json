{
  "version": 1,
  "description": "Agent-skills pack policy hooks — copy to .cursor/hooks.json and adjust paths. Uses core/policies/mcp-tool-map.yaml for tool-to-action resolution.",
  "hooks": {
    "sessionStart": [
      {
        "command": "echo 'Load core/rules/code.md and active role from agent-skills pack'"
      }
    ],
    "preToolUse": [
      {
        "command": "python3 AGENT_SKILLS_ROOT/core/scripts/hooks/check-policy.py",
        "matcher": "Shell|run_terminal_cmd|write|delete|write_file|delete_file|create_file"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python3 AGENT_SKILLS_ROOT/core/scripts/hooks/check-policy.py",
        "matcher": "*"
      }
    ],
    "postToolUse": [
      {
        "command": "python3 AGENT_SKILLS_ROOT/core/scripts/hooks/log-trace-span.py",
        "matcher": "*"
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 AGENT_SKILLS_ROOT/core/scripts/hooks/log-trace-span.py",
        "matcher": "*"
      }
    ]
  },
  "environment": {
    "AGENT_SKILLS_ROOT": "/path/to/agent-skills",
    "AGENT_ACTIVE_ROLE": "agent-coordinator",
    "AGENT_TRACE_ID": ""
  }
}
