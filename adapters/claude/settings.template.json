{
  "$schema": "https://json.schemastore.org/claude-settings.json",
  "description": "Claude Code project settings template for the agent-skills pack. Copy to .claude/settings.json in your workspace root.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 core/scripts/hooks/check-policy.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(python3 core/scripts/*)",
      "Bash(npm run test*)",
      "Bash(npm run lint*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~*)"
    ]
  },
  "model": "claude-3-7-sonnet",
  "env": {
    "AGENT_SKILLS_ROOT": "."
  }
}
