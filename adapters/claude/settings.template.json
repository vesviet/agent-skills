{
  "$schema": "https://json.schemastore.org/claude-settings.json",
  "description": "Claude Code project settings template for the agent-skills pack. Copy to .claude/settings.json in your workspace root. Runtime hook profiles: AGENT_HOOK_PROFILE (minimal|standard|strict); bypass via AGENT_DISABLED_HOOKS.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 core/scripts/hooks/session-start.py --format json"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 core/scripts/hooks/check-policy.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(python3 core/scripts/*)",
      "Bash(npm run test*)",
      "Bash(npm run lint*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~*)",
      "Bash(*--no-verify*)",
      "Bash(*core.hooksPath*)"
    ]
  },
  "model": "claude-3-7-sonnet",
  "env": {
    "AGENT_SKILLS_ROOT": ".",
    "AGENT_HOOK_PROFILE": "standard",
    "AGENT_DISABLED_HOOKS": ""
  }
}
