{
  "version": 1,
  "description": "Agent-skills pack policy hooks. Uses core/policies/mcp-tool-map.yaml for tool-to-action resolution.",
  "hooks": {
    "sessionStart": [
      {
        "command": "echo 'agent-skills: load core/rules/code.md + active role before acting'"
      }
    ],
    "preToolUse": [
      {
        "command": "python3 core/scripts/hooks/check-policy.py",
        "matcher": "Shell|run_terminal_cmd|write|delete|write_file|delete_file|create_file|edit_file|move_file"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python3 core/scripts/hooks/check-policy.py",
        "matcher": "*"
      }
    ],
    "postToolUse": [
      {
        "command": "python3 core/scripts/hooks/log-trace-span.py",
        "matcher": "*"
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 core/scripts/hooks/log-trace-span.py",
        "matcher": "*"
      }
    ]
  },
  "environment": {
    "AGENT_ACTIVE_ROLE": "agent-coordinator",
    "AGENT_TRACE_ID": ""
  }
}
